# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Supabase > Project Settings > API). A chave "publishable" (ou "anon") é pública por
# desenho: quem protege os dados são as políticas RLS do supabase/schema.sql.
# NUNCA coloque aqui a chave "service_role" nem a "secret".
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional, mas recomendado: anti-robô no login e cadastro (Cloudflare Turnstile).
# Use a "Site key" (pública). A "Secret key" vai só no painel do Supabase. Veja SEGURANCA.md.
# Só preencha DEPOIS de ativar o CAPTCHA no Supabase, ou deixe vazio para desativar.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
