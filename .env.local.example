# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Supabase > Project Settings > API). A chave "publishable" (ou "anon") é pública por
# desenho: quem protege os dados são as políticas RLS do schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
